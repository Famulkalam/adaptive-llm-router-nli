# ============================================================
# Environment Variables — Adaptive NLI Router
# ============================================================
# Copy this file to .env and fill in your keys:
#   cp .env.example .env

# OpenAI API Key (required for GPT-4o / GPT-4o-mini inference)
OPENAI_API_KEY=your_openai_api_key_here

# Model to use (default: gpt-4o)
OPENAI_MODEL=gpt-4o

# Optional: Google Gemini API Key (for Gemini-based inference)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-flash
