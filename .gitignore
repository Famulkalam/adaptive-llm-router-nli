# ============================================================
# LLMOps .gitignore — Adaptive NLI Router
# ============================================================

# ---- API Keys & Secrets ----
.env
secret_keys.json
*.key

# ---- Model Weights (HuggingFace / PyTorch) ----
*.bin
*.safetensors
*.h5
*.pt
*.pth
*.pkl
model_cache/
huggingface/

# ---- Datasets & Data Artifacts ----
*.csv
*.jsonl
*.parquet
data/raw/

# ---- Logs ----
*.log

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
venv/
.venv/
env/

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- IDE ----
.vscode/
.idea/
*.swp
*.swo

# ---- OS ----
.DS_Store
Thumbs.db

# ---- Compressed ----
*.zip
*.tar.gz

# ---- Output Figures (generated, not source) ----
outputs/figures/*.png
outputs/figures/*.pdf
